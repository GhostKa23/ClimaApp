<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppClima.Views.ClimaView"
             Title="ClimaView">
    <VerticalStackLayout>
        <Image
            Source="dotnet_bot.png"
            WidthRequest="400"
            x:Name ="CondicaoImage"/>
        
        <Label x:Name="CondicaoLabel"
               Text="Talvez esteja chovendo, tem que ver"
            />

        <HorizontalStackLayout>
            <Label Text="Minima"/>
            <Label 
                x:Name="TemperaturaMinimaLabel"
                Text="0"/>
            <Label Text="Maxima"/>
            <Label 
                x:Name="TemperaturaMaximaLabel"
                Text="99"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            
            
        </HorizontalStackLayout>




    </VerticalStackLayout>
</ContentPage>